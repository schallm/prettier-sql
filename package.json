{
  "name": "prettier-sql",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm -r build && changeset publish",
    "release": "npm whoami --registry https://registry.npmjs.org 2>/dev/null || npm login && changeset version && pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^24.13.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
