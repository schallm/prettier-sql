{
  "name": "prettier-sql",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sequential build",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm -r --sequential build && changeset publish",
    "release": "npm whoami --registry https://registry.npmjs.org 2>/dev/null || npm login && changeset version && pnpm -r --sequential build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
