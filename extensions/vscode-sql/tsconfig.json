{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "bundled", "dist"]
}
