{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "prettier-sql",
    "displayName": "Prettier SQL",
    "description": "Format T-SQL and PostgreSQL files using Prettier. Powered by prettier-plugin-tsql and prettier-plugin-postgresql.",
    "version": "0.1.1",
    "publisher": "PickyCode",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/schallm/prettier-sql"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters"
    ],
    "keywords": [
        "sql",
        "tsql",
        "t-sql",
        "postgresql",
        "pgsql",
        "prettier",
        "formatter",
        "sqlserver"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "tsql",
                "aliases": [
                    "T-SQL",
                    "tsql"
                ],
                "extensions": [
                    ".tsql"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "pgsql",
                "aliases": [
                    "PostgreSQL",
                    "pgsql"
                ],
                "extensions": [
                    ".pgsql"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "title": "Prettier SQL",
            "properties": {
                "prettierSql.defaultDialect": {
                    "type": "string",
                    "enum": [
                        "tsql",
                        "pgsql"
                    ],
                    "default": "tsql",
                    "description": "Dialect used when formatting plain .sql files. Add a --tsql or --pgsql comment at the top of a file to override this on a per-file basis.",
                    "enumDescriptions": [
                        "T-SQL / SQL Server — use for .sql files in SQL Server projects",
                        "PostgreSQL — use for .sql files in PostgreSQL projects"
                    ]
                },
                "prettierSql.sqlKeywordCase": {
                    "type": "string",
                    "enum": [
                        "lower",
                        "upper",
                        "preserve"
                    ],
                    "default": "lower",
                    "description": "Casing applied to SQL keywords (SELECT, FROM, WHERE, etc.).",
                    "enumDescriptions": [
                        "lowercase — select, from, where  (recommended)",
                        "UPPERCASE — SELECT, FROM, WHERE",
                        "Preserve — leave keywords exactly as written in the source"
                    ]
                },
                "prettierSql.sqlDensity": {
                    "type": "string",
                    "enum": [
                        "compact",
                        "standard",
                        "spacious"
                    ],
                    "default": "standard",
                    "description": "Controls how much vertical space the formatter uses when laying out statements.",
                    "enumDescriptions": [
                        "Compact — fit as much as possible on each line, wrap only at printWidth",
                        "Standard — one clause per line; short predicates stay inline  (recommended)",
                        "Spacious — like Standard but every predicate gets its own indented line"
                    ]
                },
                "prettierSql.sqlCommaStyle": {
                    "type": "string",
                    "enum": [
                        "trailing",
                        "leading"
                    ],
                    "default": "trailing",
                    "description": "Position of commas in multi-line column lists and VALUES clauses.",
                    "enumDescriptions": [
                        "Trailing — comma at the end of the line:  col1,\\n  col2",
                        "Leading  — comma at the start of the line: col1\\n, col2"
                    ]
                },
                "prettierSql.printWidth": {
                    "type": "integer",
                    "default": 120,
                    "minimum": 40,
                    "maximum": 500,
                    "markdownDescription": "Maximum line length before the formatter wraps to the next line. Wider values keep more on one line; narrower values produce more vertical output. `120` works well for most SQL editors."
                }
            }
        },
        "commands": [
            {
                "command": "prettierSql.formatDocument",
                "title": "Format SQL Document",
                "category": "Prettier SQL"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p tsconfig.json",
        "watch": "tsc -p tsconfig.json --watch",
        "package": "node scripts/pack.mjs",
        "publish": "node scripts/pack.mjs && vsce publish"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^6.0.3"
    }
}
