{
  "name": "prettier-plugin-pgsql",
  "version": "0.1.0",
  "description": "Prettier plugin for PostgreSQL using the official libpg_query parser",
  "author": "Mike Schall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schallm/prettier-plugin-pgsql.git"
  },
  "homepage": "https://github.com/schallm/prettier-plugin-pgsql#readme",
  "bugs": {
    "url": "https://github.com/schallm/prettier-plugin-pgsql/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin/dotnet"
  ],
  "keywords": [
    "prettier",
    "prettier-plugin",
    "sql",
    "postgresql",
    "postgres",
    "pgsql",
    "formatter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "node-api-dotnet": "0.9.19"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build:dotnet": "dotnet restore src/dotnet/PgScriptDom/PgScriptDom.csproj && dotnet msbuild src/dotnet/PgScriptDom/PgScriptDom.csproj /t:Publish /p:Configuration=Release \"/p:PublishDir=../../../bin/dotnet/\" && node scripts/copy-native.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:ts:watch": "tsc -p tsconfig.json --watch",
    "build": "npm run build:dotnet && npm run build:ts",
    "format:ts": "prettier --write \"src/plugin/**/*.ts\"",
    "format:md": "prettier --write \"**/*.md\" --ignore-path .gitignore",
    "format:cs": "dotnet format src/dotnet/PgScriptDom/PgScriptDom.csproj",
    "format": "npm run format:ts && npm run format:md && npm run format:cs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs",
    "fix:docs": "node scripts/check-docs.mjs --fix",
    "preversion": "npm test",
    "version": "npm run build",
    "postversion": "git push && git push --tags && npm publish"
  }
}
