{
  "name": "prettier-plugin-postgresql",
  "version": "0.2.6",
  "description": "Prettier plugin for PostgreSQL using the official libpg_query parser",
  "author": "Mike Schall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schallm/prettier-sql.git",
    "directory": "packages/plugin-pgsql"
  },
  "homepage": "https://github.com/schallm/prettier-sql/tree/main/packages/plugin-pgsql#readme",
  "bugs": {
    "url": "https://github.com/schallm/prettier-sql/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin/dotnet"
  ],
  "keywords": [
    "prettier",
    "prettier-plugin",
    "sql",
    "postgresql",
    "postgres",
    "pgsql",
    "formatter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "node-api-dotnet": "0.9.21"
  },
  "devDependencies": {
    "@prettier-sql/core": "workspace:*"
  },
  "scripts": {
    "build:dotnet": "dotnet restore src/dotnet/PgScriptDom/PgScriptDom.csproj && dotnet msbuild src/dotnet/PgScriptDom/PgScriptDom.csproj /t:Publish /p:Configuration=Release \"/p:PublishDir=../../../bin/dotnet/\" && node scripts/copy-native.mjs",
    "build:ts": "tsc -p tsconfig.json && node scripts/bundle-core.mjs",
    "build:ts:watch": "tsc -p tsconfig.json --watch",
    "build": "pnpm run build:dotnet && pnpm run build:ts",
    "format:ts": "prettier --write \"src/plugin/**/*.ts\"",
    "format:md": "prettier --write \"**/*.md\" --ignore-path .gitignore",
    "format:cs": "dotnet format src/dotnet/PgScriptDom/PgScriptDom.csproj",
    "format": "pnpm run format:ts && pnpm run format:md && pnpm run format:cs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs",
    "fix:docs": "node scripts/check-docs.mjs --fix",
    "format:sql": "node scripts/format-sql.mjs"
  }
}
