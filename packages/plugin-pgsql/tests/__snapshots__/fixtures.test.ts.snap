"-- Every clause of a column or table constraint
create table t (
  a integer references p (id) match full
);

create table t (
  a integer,
  check (a > 0) no inherit
);

create table t (
  a integer,
  unique (a) include (b) with (fillfactor = 70) using index tablespace ts
);

create table t (
  a integer,
  b integer,
  foreign key (a, b) references p on delete set null (b)
);

create table t (
  a integer generated by default as identity (start with 10 increment by 5)
);

create table t (
  a integer,
  primary key (a) deferrable initially deferred
);

create table t (
  a integer constraint nn not null
);

alter table t
  add constraint u unique using index i;

alter table t
  add constraint c check (a > 0) not valid;

create table t (
  a integer,
  exclude using gist (a with =) where (a > 0)
);

create table t (
  a text collate "C",
  b integer default 1 check (b > 0)
);

create table t (
  a integer references p on update cascade on delete restrict deferrable
);

create table t (
  a integer,
  exclude using gist (a with =)
);
"
`;

exports[`fixtures > ddl/create-function.sql 1`] = `
"-- Simple SQL function
create function get_book_count(p_author_id integer)
returns bigint
language sql
as $$
  select count(*) from books where author_id = p_author_id
$$;

-- Function with multiple parameters
create function full_name(first_name text, last_name text)
returns text
language sql
as $$
  select first_name || ' ' || last_name
$$;

-- Function with OUT parameters
create function get_stats(in p_author_id integer, out book_count bigint, out avg_price numeric)
language sql
as $$
  select count(*), avg(price) from books where author_id = p_author_id
$$;

-- Function with INOUT parameter
create function increment(inout val integer)
language sql
as $$
  select val + 1
$$;

-- RETURNS TABLE
create function books_by_author(p_author_id integer)
returns table (id integer, title text, price numeric)
language sql
as $$
  select id, title, price from books where author_id = p_author_id
$$;

-- STABLE, STRICT, SECURITY DEFINER
create function safe_divide(a numeric, b numeric)
returns numeric
language sql
stable
strict
security definer
as $$
  select a / b
$$;
"
`;

exports[`fixtures > ddl/create-index.sql 1`] = `
"-- Expression index (pgsql-specific)
create index idx_users_lower_email on users (lower(email));

-- INCLUDE columns (covering index)
create index idx_orders_lookup on orders (customer_id) include (status, amount);

-- Specific index method
create index idx_events_data on events using gin (data);

create index idx_locations on places using gist (location);

-- CREATE INDEX CONCURRENTLY
create index concurrently idx_big_table_col on big_table (col);

-- IF NOT EXISTS
create index if not exists idx_books_author on books (author_id);

-- WITH reloption value (bare identifier like on/off must keep its value)
create index idx_events_gin on events using gin (data) with (fastupdate = off);
"
`;

