exports[`fixtures > select/json-constructors.sql 1`] = `
"-- JSON_OBJECT constructor (SQL/JSON standard, PostgreSQL 16+)
select json_object('title': b.title, 'author': a.name)
from
  books as b
  join authors as a on a.id = b.author_id;

-- JSON_OBJECT with ABSENT ON NULL
select json_object('title': b.title, 'subtitle': b.subtitle absent on null)
from books as b;

-- JSON_OBJECT aggregate
select
  a.name,
  json_objectagg(b.isbn: b.title)
from
  authors as a
  join books as b on b.author_id = a.id
group by a.name;

-- JSON_ARRAY aggregate
select
  a.name,
  json_arrayagg(b.title)
from
  authors as a
  join books as b on b.author_id = a.id
group by a.name;

-- JSON_ARRAY aggregate with ABSENT ON NULL
select
  a.name,
  json_arrayagg(b.subtitle)
from
  authors as a
  join books as b on b.author_id = a.id
group by a.name;
"
`;

