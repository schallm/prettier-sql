exports[`fixtures > delete/returning.sql 1`] = `
"delete from sessions
where expires_at < now()
returning
  id,
  user_id;
"
`;

exports[`fixtures > dml/cte-dml.sql 1`] = `
"with
  moved as (
    delete from orders
    where status = 'cancelled'
    returning
      id,
      customer_id,
      amount
  )
insert into archived_orders (id, customer_id, amount)
select
  id,
  customer_id,
  amount
from
  moved;

delete from sessions
where (
  select
    id
  from
    updated
);
"
`;

exports[`fixtures > dml/truncate.sql 1`] = `
"truncate table sessions;

truncate table sessions, temp_orders restart identity cascade;
"
`;

