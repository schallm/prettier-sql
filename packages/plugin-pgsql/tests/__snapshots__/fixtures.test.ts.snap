exports[`fixtures > p6/sql-json-predicates-constructors.sql 1`] = `
"select a is json
from t;

select
  a is json,
  a is json object,
  a is json array,
  a is json scalar,
  a is not json,
  a is not json object with unique keys,
  a is json with unique keys,
  a is json
from t;

select
  a || b is json,
  (a is json) is true,
  a is not json,
  (a is json) = (b is json)
from t;

select *
from t
where
  a is json object
  and b is not json array;

select
  json_scalar(1),
  json_scalar(a),
  json_scalar('x' || y);

select
  json_serialize(a),
  json_serialize(a returning text),
  json_serialize(a format json returning bytea),
  json_serialize(a format json encoding utf8)
from t;

select
  json(a),
  json(a with unique keys),
  json(a format json),
  json('{}' with unique keys);

select
  json_object('a': 1, 'b': 2),
  json_object('a': 1),
  json_object('a': 1),
  json_object('a': 1 absent on null with unique keys returning jsonb),
  json_object('a': b format json),
  json_object(),
  json_object(returning jsonb);

select
  json_array(1, 2),
  json_array(a, b null on null),
  json_array(a format json),
  json_array(returning text),
  json_array(1 returning jsonb),
  json_array();

select
  json_objectagg(a: b),
  json_objectagg(a: b with unique keys returning jsonb),
  json_objectagg(a: b absent on null) filter (where x) over (partition by y)
from t;

select
  json_arrayagg(a),
  json_arrayagg(a order by b),
  json_arrayagg(a null on null returning jsonb),
  json_arrayagg(a format json order by b desc) filter (where x)
from t;

select
  json_query(a, '$.x'),
  json_query(a, '$.x' passing 1 as v, 2 as w),
  json_query(a, '$' returning jsonb),
  json_query(a, '$' with wrapper),
  json_query(a, '$' with conditional wrapper),
  json_query(a, '$' without wrapper),
  json_query(a, '$' keep quotes),
  json_query(a, '$' omit quotes),
  json_query(a, '$' empty array on empty),
  json_query(a, '$' empty object on error),
  json_query(a, '$' error on error),
  json_query(a, '$' default '1' on empty),
  json_query(a format json, '$')
from t;

select
  json_value(a, '$.x'),
  json_value(a, '$' returning integer),
  json_value(a, '$' default 0 on empty default 1 on error),
  json_value(a, '$' null on empty error on error),
  json_value(a, '$' passing b as x)
from t;

select
  json_exists(a, '$.x'),
  json_exists(a, '$' passing 1 as v),
  json_exists(a, '$' error on error),
  json_exists(a, '$' true on error),
  json_exists(a, '$' false on error),
  json_exists(a, '$' unknown on error)
from t;

select *
from json_table(
  a,
  '$[*]'
  columns (
    x integer path '$.x',
    y text path '$.y' default 'a' on empty error on error,
    z integer exists path '$.z',
    n for ordinality,
    j jsonb format json path '$' with wrapper keep quotes,
    nested path '$.k[*]' columns (
      q integer path '$.q'
    )
  )
) as jt;

select *
from json_table(
  a,
  '$' as p passing 1 as v
  columns (
    x integer
  ) error on error
) as jt;

select *
from json_table(
  a,
  '$'
  columns (
    x integer path '$' true on error
  )
) as jt;

select *
from
  t,
  json_table(
    t.a,
    '$[*]'
    columns (
      x integer path '$.x'
    ) empty array on error
  ) as jt(x);

select *
from json_table(
  a,
  '$'
  columns (
    nested path '$.k' as pn columns (
      q integer
    ),
    x text path 'lax $.x' omit quotes
  )
) as jt;

select json_query(a, '$' returning text format json encoding utf8)
from t;

select json_object('a': json_array(1, 2), 'b': json_object('c': 1));

select json_value(a, '$' returning integer default 1 + 1 on empty)
from t;

select
  a::json -> 'x' ->> 'y',
  a #> '{x}',
  a @> b
from t;

select json_exists(a format json encoding utf8, '$')
from t;

select *
from xmltable(
  '/a'
  passing x
  columns
    b integer path 'b'
) as xt(b);

select *
from xmltable(
  xmlnamespaces('u' as n, default 'd'),
  '/a'
  passing x
  columns
    b integer path 'b',
    c for ordinality,
    d text default 'x' not null
) as xt;

select *
from json_table(
  a,
  '$'
  columns (
    x integer
  )
) as jt(x);

select json_array(
  select 1
);

select json_array(
  select a
  from t
  order by a
);

select json_array(
  select a
  from t
  format json
);

select json_array(
  select a
  from t
  returning jsonb
);

select json_array(
  select a
  from t
  format json returning jsonb format json
);

select json_array(
  select
    a,
    b
  from t
  where a > 1
  limit 1
  returning text
);

select
  json_object(returning jsonb),
  json_array(returning text),
  json_object('a': 1 returning jsonb);

select
  json_arrayagg(a),
  json_arrayagg(a order by b null on null returning text)
from t;

select
  x is json,
  y is not json,
  json_scalar(1 + 1) is json scalar
from t;

select (a is json with unique keys) is true
from t;

select *
from t
where
  json_exists(a, '$.x')
  and a is json object;

select json_serialize(json_array(
  select a
  from t
) returning text);
