exports[`fixtures > select/aggregate-filter.sql 1`] = `
"select
  author_id,
  count(*) filter (where in_stock = 1) as in_stock_count,
  count(*) filter (where in_stock = 0) as out_of_stock_count
from
  books
group by
  author_id;

select
  author_id,
  string_agg(title, ', ' order by title) as titles
from
  books
group by
  author_id;
"
`;

exports[`fixtures > select/basic.sql 1`] = `
"select
  id,
  title,
  price
from
  books
where in_stock = true
order by
  price asc;

select
  b.id,
  b.title,
  a.first_name,
  a.last_name
from
  books as b
  join authors as a on b.author_id = a.id
where b.price < 50;
"
`;

exports[`fixtures > select/distinct-on.sql 1`] = `
"select distinct on (author_id)
  id,
  author_id,
  title
from
  books
order by
  author_id,
  price asc;
"
`;

exports[`fixtures > select/for-update.sql 1`] = `
