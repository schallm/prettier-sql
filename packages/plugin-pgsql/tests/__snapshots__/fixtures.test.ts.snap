exports[`fixtures > ddl/create-table-options.sql 1`] = `
"-- Persistence, IF NOT EXISTS, INHERITS and storage clauses change what CREATE TABLE creates
create temporary table t (
  a integer
)
on commit drop;

create temporary table if not exists t (
  a integer
)
on commit delete rows;

create unlogged table t (
  a integer
);

create table if not exists t (
  like u including all
);

create table t (
  like u including all excluding comments
);

create table t (
  like u including comments including indexes
);

create table t (
  a integer
)
inherits (u, s.v);

create table t (
  a integer
)
with (fillfactor = 70, toast.autovacuum_enabled = false)
tablespace "Fast";

-- a bare reloption value that needs quoting to keep its case (would fold to lowercase otherwise)
create table t (
  a integer
)
with (x = "Off");

create table t (
  a integer
)
using heap;

create temporary table t as
select 1;

create unlogged table t (x, y)
with (fillfactor = 50) as
select
  1,
  2
with no data;

create materialized view mv (x) as
select 1
with no data;

create materialized view if not exists mv as
select 1;
"
`;

exports[`fixtures > ddl/ddl-options.sql 1`] = `
"-- Views, index elements, column collations, sequence options, DROP CONCURRENTLY and CTE materialization
create or replace view v (x, "Y")
with (security_barrier = true)
as
select
  1,
  2
with cascaded check option;

create or replace temporary view v
as
select 1
with local check option;

create view v
as
select 1
with cascaded check option;

create unique index concurrently if not exists i on only t (a desc nulls last, lower(b) text_pattern_ops, c collate "C" nulls first) include (d) nulls not distinct with (fillfactor = 80) tablespace fast where e is not null;

create index i on t ((a + b), (x::text));

create table t (
  a text collate "C",
  b text collate pg_catalog."default" not null
);

create temporary sequence s
as bigint
start with 10
increment by -2
minvalue -9223372036854775808
maxvalue 9223372036854775807
cache 5
cycle
owned by t.a;

alter sequence s
owned by none
restart with 100;

drop index concurrently if exists i;

with
  c as materialized (
    select 1
  ),
  d as not materialized (
    select 2
  )
select *
from
  c,
  d;
"
`;

