`;

exports[`fixtures > ddl/drop-targets.sql 1`] = `
"-- DROP forms whose target is more than a name list
drop trigger if exists tr on s.t cascade;

drop policy p on t;

drop rule r on t;

drop operator class oc using btree;

drop operator family s.of using hash cascade;

drop cast (text as integer);

drop cast if exists (bigint as "char");

drop transform for hstore language plpython3u;

drop aggregate a(*), b(integer);

drop type "char", mood, s.t;

drop domain d;

drop operator === (integer, integer), @@ (text, none);

drop table a, s.b;
"
`;

exports[`fixtures > ddl/function-attributes.sql 1`] = `
"-- OR REPLACE, procedures, attributes (volatility, STRICT, SECURITY DEFINER, ...), SETOF, parameter defaults, C symbols and $$ inside a body
create or replace function f(a integer default 1, in b text default 'x', out c integer)
returns setof integer
language plpgsql
immutable
strict
security definer
parallel safe
cost 10
rows 5
set search_path = 'MySchema', pg_temp
as $$ begin end $$;

create function g()
returns integer
language c
stable
leakproof
called on null input
security invoker
as 'mylib', 'g_impl';

create function h()
returns text
language sql
as $body$ select '$$' $body$;

create function k(variadic xs integer[])
returns table (x integer, y text)
language sql
set work_mem from current
as $$select 1, 'a'$$;

create procedure p(inout n integer)
language plpgsql
as $$ begin n := n + 1; end $$;

create or replace procedure q()
language sql
security definer
as $$select 1$$;
"
`;

exports[`fixtures > ddl/grant-options.sql 1`] = `
"-- Column lists, GRANT OPTION FOR, GRANTED BY and pseudo-roles
grant select, insert (a, "B"), update (c) on table t
to r
with grant option;
grant all privileges on table t
to "Role Name", public;
grant select on table t
to current_user, session_user;
grant select on table t
to r
granted by current_user;
revoke grant option for select on table t
from r
cascade;
revoke update (c) on table t
from r;
grant usage on schema s
to r;
grant select on all tables in schema s
to r;
grant execute on function f(integer)
to r;
"
`;

exports[`fixtures > ddl/grant-revoke.sql 1`] = `
"-- GRANT on specific tables
grant select, insert on table books
to alice;
grant all privileges on table orders
to bob;
-- GRANT on schema
grant usage on schema myschema
to alice;
-- GRANT on all tables in schema
grant select on all tables in schema public
to alice;
-- GRANT to public
grant execute on function get_count(integer)
to public;
-- REVOKE
revoke select on table books
from alice;
revoke all privileges on table orders
from bob
cascade;
-- WITH GRANT OPTION
grant select on table books
to alice
with grant option;
"
`;

exports[`fixtures > ddl/object-signatures.sql 1`] = `
"-- Argument types identify an overload, and an operator always needs them
drop operator === (integer, integer);

drop operator if exists @@ (text, none) cascade;

drop operator ~~~ (none, integer);

drop function f(integer, text);

drop function f();

drop function if exists s.f;

drop function "MyFn"("MyType"), g(integer[]);

alter function s.f(integer) owner to r;
alter function f(integer) set schema x;
comment on function f(integer) is 'x';

drop aggregate my_agg(integer);

grant execute on function f(integer, text)
to r;
"
`;

exports[`fixtures > ddl/policies.sql 1`] = `
"create policy view_own_data
on users
for select
using (user_id = current_user_id());

alter policy view_own_data
on users
using (user_id = current_user_id());

-- WITH CHECK (for INSERT/UPDATE)
create policy insert_own_rows
on orders
for insert
with check (customer_id = current_user_id());

-- USING and WITH CHECK together
create policy manage_own_orders
on orders
for all
using (customer_id = current_user_id())
with check (customer_id = current_user_id());

-- FOR UPDATE
create policy update_own_profile
on users
for update
using (id = current_user_id())
with check (id = current_user_id());

-- FOR DELETE
create policy delete_own_sessions
on sessions
for delete
using (user_id = current_user_id());

-- Permissive vs restrictive
create policy admin_all
on orders
for all
to admin_role
using (true);

create policy restrict_sensitive
on users
as restrictive
for all
using (not is_internal);

-- TO roles: quoted role names and pseudo-roles
create policy auditors_read
on orders
for select
to "Auditors", current_user
using (true);

-- ALTER POLICY: an explicit TO public is a change and must be kept
alter policy admin_all
on orders
to public
using (true);
"
`;

