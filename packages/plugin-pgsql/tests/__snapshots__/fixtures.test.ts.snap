  title
from
  books
where id not in (1, 2, 3);

select
  id,
  title,
  price
from
  books
where price between 10 and 50;

select
  id,
  title,
  price
from
  books
where price not between 10 and 50;
"
`;

exports[`fixtures > select/lateral.sql 1`] = `
"select
  b.id,
  r.avg_price
from
  books as b,
  lateral (
    select
      avg(price) as avg_price
    from
      books
    where author_id = b.author_id
  ) as r;
"
`;

