exports[`fixtures > dml/cte-dml.sql 1`] = `
"with
  moved as (
    delete from orders
    where status = 'cancelled'
    returning
      id,
      customer_id,
      amount
  )
insert into archived_orders (id, customer_id, amount)
select
  id,
  customer_id,
  amount
from
  moved;

delete from sessions
where (
  select
    id
  from
    updated
);

-- WITH ... INSERT (insert from CTE)
with
  new_data as (
    select
      customer_id,
      sum(amount) as total
    from
      raw_orders
    group by
      customer_id
  )
insert into order_summary (customer_id, total)
select
  customer_id,
  total
from
  new_data;

-- WITH ... UPDATE
update sessions
set active = false
where (
  select
    id
  from
    stale
);
"
`;

