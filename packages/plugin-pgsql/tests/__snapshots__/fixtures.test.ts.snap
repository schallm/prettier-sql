exports[`fixtures > select/advanced.sql 1`] = `
"select
  interval '1 day',
  interval '2 hours 30 minutes'
from
  t;

select
  price::numeric,
  name::text,
  '2024-01-01'::date
from
  t;

select
  arr[1],
  arr[2:4],
  arr[:3],
  arr[1:]
from
  t;

select
  make_date(year => 2024, month => 1, day => 15);

select
  dept,
  sum(salary)
from
  emp
group by
  rollup(dept);

select
  dept,
  job,
  sum(salary)
from
  emp
group by
  cube(dept, job);

select
  dept,
  job,
  sum(salary)
from
  emp
group by
  grouping sets((dept, job), (dept), ());
"
`;

