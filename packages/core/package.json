{
  "name": "@prettier-sql/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./options": "./dist/options.js",
    "./printer/utils": "./dist/printer/utils.js",
    "./printer/helpers": "./dist/printer/helpers.js",
    "./printer/layout": "./dist/printer/layout.js",
    "./parser": "./dist/parser/loadDotnet.js"
  },
  "scripts": {
    "build:dotnet": "dotnet build src/dotnet/Core/PrettierSql.Core.csproj -c Release",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:dotnet && npm run build:ts"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  }
}
