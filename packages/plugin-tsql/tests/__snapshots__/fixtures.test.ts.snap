restore headeronly
  from disk = N'C:\\Backups\\Bookstore_Full.bak';

restore verifyonly
  from disk = N'C:\\Backups\\Bookstore_Full.bak';

drop database Bookstore;

drop database if exists Bookstore;

drop database Bookstore, BookstoreDev;"
`;

