begin
  set nocount on;
  set xact_abort on;
  declare @x int = 0;
  declare @y int = 0;

  if @x > 0
  begin
    set @x = 1;
    return;
  end

  update T
  set Col = @x
  where Id = 1;
end;
go
"
`;

exports[`options > raiserror: long args fill-pack in compact 1`] = `
"if @rowsAdded <> @expected
begin
  raiserror (
    'Expected to add %d rows but actually added %d rows. Rolling back.', 16, 1,
    @expected, @rowsAdded
  );
  return;
end
"
`;

