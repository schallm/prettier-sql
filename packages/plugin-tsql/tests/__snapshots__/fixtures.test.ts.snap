from dbo.t
option (concat union, parameterization forced, no_performance_spool);

select a
from dbo.t
option (ignore_nonclustered_columnstore_index, use plan n'<x/>');

select a
from dbo.t
option (fast 10, maxdop 2, force order, optimize for (@a unknown, @b = 'X'));

select *
from dbo.t with (spatial_window_max_cells = 10);

select *
from dbo.t with (
  keepidentity,
  keepdefaults,
  ignore_constraints,
  ignore_triggers
);

