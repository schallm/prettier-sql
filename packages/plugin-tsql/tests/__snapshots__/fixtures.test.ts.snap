  j.amount
from
  Orders as o
  cross apply openjson(o.JsonData, '$.items') with (
    OrderId int '$.id',
    amount decimal(10,2) '$.amount',
    notes nvarchar(500) '$.notes'
  ) as j;

select
  j.id,
  j.data
from openjson(@json) with (
  id int '$.id',
  data nvarchar(max) '$.data' as json
) as j;

