"-- DROP CLUSTERED CONSTRAINT WITH options (ONLINE, WAIT_AT_LOW_PRIORITY, MAXDOP) must be preserved
alter table dbo.Orders
drop constraint
  PK_Orders with (ONLINE = ON, wait_at_low_priority (max_duration = 5 minutes, abort_after_wait = self));

alter table dbo.Orders
drop constraint
  IX_Orders_Date with (ONLINE = ON, wait_at_low_priority (max_duration = 10 minutes, abort_after_wait = blockers));

alter table dbo.BigTable
drop constraint CL_BigTable with (ONLINE = ON, MAXDOP = 4);"
`;

