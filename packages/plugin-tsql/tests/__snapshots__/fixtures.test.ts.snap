exports[`fixtures > admin/long-backup-restore-create-database.sql 1`] = `
"backup database SalesDatabase
  file = 'SalesData1', file = 'SalesData2', filegroup = 'SalesFileGroup'
  to disk = 'D:\\backups\\SalesDatabase_full_20240101.bak',
  disk = 'E:\\backups\\SalesDatabase_full_20240101.bak'
  mirror to disk = 'F:\\mirror\\SalesDatabase_full_20240101.bak',
  disk = 'G:\\mirror\\SalesDatabase_full_20240101.bak'
  with
    format,
    init,
    compression,
    checksum,
    stats = 10,
    encryption (
      algorithm = aes_256,
      server certificate = BackupEncryptionCertificate
    );

backup log SalesDatabase
  to disk = 'D:\\backups\\SalesDatabase_log.trn'
  with
    noinit,
    compression,
    encryption (algorithm = aes_256, server asymmetric key = BackupKey);

restore database SalesDatabase
  filegroup = 'SalesFileGroup', page = '1:57'
  from disk = 'D:\\backups\\SalesDatabase_full_20240101.bak'
  with
    norecovery,
    move 'SalesData' to 'D:\\data\\SalesData.mdf',
    move 'SalesLog' to 'E:\\log\\SalesLog.ldf',
    stats = 5,
    partial;

restore log SalesDatabase
  from disk = 'D:\\backups\\SalesDatabase_log.trn'
  with stopatmark = 'MarkedTransaction' after '2024-01-01T12:00:00', norecovery;

restore database SalesDatabase
  from disk = 'D:\\backups\\SalesDatabase_full.bak'
  with
    filestream (directory_name = 'SalesFileStreamDirectory'),
    recovery,
    replace;

restore database SalesDatabase
  from database_snapshot = 'SalesDatabaseSnapshot20240101';

create database SalesDatabase containment = partial
on
  primary (
    name = SalesData,
    filename = 'D:\\data\\SalesData.mdf',
    size = 100mb,
    maxsize = unlimited,
    filegrowth = 10%
  ),
  filegroup SalesFileGroup
    (name = SalesData2, filename = 'D:\\data\\SalesData2.ndf')
log on
  (name = SalesLog, filename = 'E:\\log\\SalesLog.ldf', size = 50mb)
collate latin1_general_100_ci_as_sc
with
  catalog_collation = sql_latin1_general_cp1_ci_as,
  ledger = on,
  trustworthy off,
  db_chaining on,
  nested_triggers = on,
  default_language = us_english;

create database SalesDatabaseSnapshot
on
  (name = SalesData, filename = 'D:\\data\\SalesData.ss'),
  (name = SalesData2, filename = 'D:\\data\\SalesData2.ss')
as snapshot of SalesDatabase;

create database RestoredDatabase
on
  (filename = 'D:\\data\\SalesData.mdf'),
  (filename = 'E:\\log\\SalesLog.ldf')
for attach
with enable_broker;

create database d (
  edition = 'basic',
  service_objective = 'basic',
  maxsize = 2 gb
);
"
`;

exports[`fixtures > admin/raw-statement-before-end-conversation.sql 1`] = `
"-- A statement kept as written must stop before END CONVERSATION, not swallow its keywords
create external language l from (content = 'x', file_name = 'y', platform = windows);

end conversation @h;

create external language m from (content = 'a', file_name = 'b', platform = linux);

end conversation @h with cleanup;

create external library lib from (content = 0x01) with (language = 'R');

end conversation @h with error = 50001 description = 'failed';
"
`;

exports[`fixtures > admin/raw-statement-comments.sql 1`] = `
"/* lead */
create external language l from (content = 'x', file_name = 'y', platform = windows) /* inside */;

backup database d
  to disk = 'x.bak'; -- trailing
go

select 1; -- before semicolon

-- after semicolon
alter schema s transfer dbo.t;
go
"
`;

exports[`fixtures > admin/scoped-config-unterminated.sql 1`] = `
"alter database scoped configuration set maxdop = 4; -- cores

select 1;
go

if 1 = 1
begin
  alter database scoped configuration set legacy_cardinality_estimation = on;
end

alter database scoped configuration clear procedure_cache;

alter database scoped configuration for secondary set maxdop = primary;
go
"
`;

exports[`fixtures > admin/service-broker.sql 1`] = `
"-- Service Broker statements — END CONVERSATION must include the handle variable
end conversation @handle;

end conversation @handle with cleanup;

end conversation @handle
  with error = 50001
  description = 'Order processing failed';

-- BEGIN DIALOG
begin dialog conversation @handle
    from service OrderService
    to service 'TargetService'
    on contract OrderContract
    with lifetime = 3600;

-- SEND ON CONVERSATION
send on conversation @handle
    message type OrderMessage
    (N'<order><id>1</id></order>');

-- RECEIVE
receive top (10)
  conversation_handle,
  message_body
from dbo.OrderQueue;

-- GET CONVERSATION GROUP
get conversation group @group_id from dbo.OrderQueue;

-- MOVE CONVERSATION
move conversation @handle to @group_id;
"
`;

