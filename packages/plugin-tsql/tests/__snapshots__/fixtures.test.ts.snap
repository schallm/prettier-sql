exports[`fixtures > procedural/nested-statement-comments.sql 1`] = `
"-- A trailing comment on a statement inside a block is printed once
if 1 = 1
begin
  print 'a'; -- after print
end

while 1 = 1
begin
  break; -- stop
end

begin try
  select 1; -- inside try
end try
begin catch
  throw; -- rethrow
end catch

if @a = 1
begin
  set @b = 1;
  set @c = 2; -- both set

  if @b = 1
  begin
    print 'x'; -- inner
  end

  print 'y';
end
else
  print 'z'; -- else branch
"
`;

