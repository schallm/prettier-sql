from dbo.Employee for system_time from '2022-01-01' to '2023-01-01';

select
  Id,
  Name
from dbo.Employee for system_time between '2022-01-01' and '2023-01-01';

select
  Id,
  Name
from dbo.Employee for system_time contained in ('2022-01-01', '2023-01-01');

select
  Id,
  Name
from dbo.Employee for system_time all;
"
`;

exports[`fixtures > select/unary-operators.sql 1`] = `
"-- Unary operators: a double negation must not become a -- comment
select
  -a,
  - -a,
