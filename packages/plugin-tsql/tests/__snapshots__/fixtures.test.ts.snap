delete from t
where a = 1
option (recompile);

insert into t
select a
from s
option (hash join);

merge into t as tgt
using (
  select 1 as id
) as src (id) on tgt.id = src.id
when matched then
  update set tgt.a = 1
when not matched by target and src.id > 0 then
  insert default values
output
  $action
into @log
option (loop join);

select *
from (
  select
    1,
    2
) as s (a, b);

select *
