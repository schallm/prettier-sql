from dbo.t
option (min_grant_percent = 10, max_grant_percent = 20);

select a
from dbo.t
option (
  table hint (dbo.T, nolock),
  table hint (T, index = Ix),
  table hint (dbo.t, forceseek(Ix(a)))
);

