  x.id,
  x.Name
from openxml(@hDoc, '/root/item', 2) with (
  id int '@id',
  Name varchar(100) 'Name'
) as x;

select
  r.id,
  r.Name
from openrowset(
  'SQLNCLI',
  'Server=(local);Trusted_Connection=yes;',
  'select id, Name from pubs.titles'
) as r;

