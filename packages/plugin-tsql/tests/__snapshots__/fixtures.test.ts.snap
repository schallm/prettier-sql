from openrowset(
  bulk 'C:\\data\\file.csv',
  formatfile='C:\\data\\fmt.xml',
  firstrow=2
) as t;

select *
from openrowset(bulk 'C:\\data\\data.json', single_blob) as j;

-- Built-in TVFs (BuiltInFunctionTableReference) — must normalize case
