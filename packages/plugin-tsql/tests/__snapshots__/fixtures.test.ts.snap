exports[`fixtures > select/window-clause-order.sql 1`] = `
"-- WINDOW comes after HAVING and before ORDER BY
select
  a,
  sum(a) over w
from t
group by a
having count(*) > 1
window w as (partition by a)
order by sum(a) over w;

select a
from t
window
  w as (partition by b),
  w2 as (
    w
    order by c
  )
order by a
offset 1 rows;
"
`;

exports[`fixtures > select/window-partition-lists.sql 1`] = `
"select
  a.id,
  row_number() over (
    partition by a.account_id, a.region_id
    order by
      a.created_at desc,
      a.id
  ) as rn
from t as a;

select
  a.id,
  count(*) over (
    partition by a.very_long_column_name_one,
      a.very_long_column_name_two,
      a.very_long_column_name_three,
      a.four
  ) as c
from t as a;

select
  a.id,
  sum(a.x) over (partition by a.account_id) as s
from t as a;

select a.id
from t as a
window
  w as (
    partition by a.account_id, a.region_id
    order by a.created_at
  ),
  v as (
    partition by a.very_long_column_name_one,
      a.very_long_column_name_two,
      a.very_long_column_name_three
  );
"
`;

exports[`fixtures > select/wrapped-lists-with-comments-and-case.sql 1`] = `
"select coalesce(
  a.very_long_column_name_one, -- first choice
  a.very_long_column_name_two,
  a.very_long_column_name_three,
  a.very_long_four
) as c
from t as a;

select iif(
  case
    when a.x = 1 then 1
  end = 1,
  a.very_long_column_name_two,
  a.very_long_column_name_three
) as c
from t as a;

select coalesce(
  (
    select max(id)
    from u
  ),
  a.very_long_column_name_two,
  a.very_long_column_name_three,
  a.very_long_four
) as c
from t as a;

select a.id
from t as a
where a.status in (
  'pending', 'shipped', -- the open states
  'cancelled', 'returned', 'refunded', 'on_hold', 'archived', 'deleted'
);

select a.id
from t as a
where a.status in (
  a.very_long_column_name_one,
  case
    when a.x = 1 then 2
  end,
  a.very_long_column_name_two
);

select
  a.id,
  sum(
    case
      when a.x = 1 then a.very_long_column_name_one
      else a.very_long_column_name_two
    end
  ) as total
from t as a
group by a.id;

select a.base_amount + a.shipping_amount * a.tax_rate - a.discount_amount -- adjusted
  + a.handling_fee + a.insurance_fee as total
from t as a;

create table dbo.t (
  id int, -- the key
  name nvarchar(100)
    default 'a default value long enough to need wrapping'
    not null
    check (len(name) > 0), -- not empty
  created datetime2 default sysutcdatetime() not null
);

declare @message nvarchar(200) = N'The order was placed by ' + @customer_name -- who
  + N' on ' + convert(nvarchar(30), @order_date, 120);

alter table dbo.Orders
drop constraint PK_Orders with (
  ONLINE = ON,
  MAXDOP = 4,
  wait_at_low_priority (max_duration = 5 minutes, abort_after_wait = self)
);
-- keep it online
"
`;

exports[`fixtures > select/xml-methods.sql 1`] = `
"-- XML instance method calls on XML-typed columns
select
  Data.value('(/root/id)[1]', 'int') as Id,
  Data.query('/root/name') as NameXml,
  Data.exist('/root/active') as IsActive
from XmlDocs;

-- XML nodes() cross apply (column alias rendered as raw text for now)
select XmlDoc.value('(./Id)[1]', 'int') as Id
from
  XmlDocs
  cross apply Data.nodes('/root/item') as n;

-- nodes() alias with a column list (n(x)) — the column list used to be dropped
select x.query('.')
from
  t
  cross apply t.x.nodes('/r') as n(x);
"
`;

